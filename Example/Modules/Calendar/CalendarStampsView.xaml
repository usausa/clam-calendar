<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamCalendar;assembly=ClamCalendar"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Calendar"
             x:Class="Example.Modules.Calendar.CalendarStampsView"
             x:DataType="{x:Type module:CalendarStampsViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CalendarStampsViewModel}"
             shell:ShellProperty.Title="Stamps"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Stamps"
             shell:ShellProperty.Function3Text="Labels"
             shell:ShellProperty.Function4Text="Today"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="*,Auto">
        <!-- Inside a ScrollView: vertical drags scroll the page, horizontal swipes on the calendar change the month -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <clam:ClamCalendarView HeightRequest="560"
                                       CalendarStyle="{StaticResource StampCalendarStyle}"
                                       DayLabels="{Binding DayLabels}"
                                       DayLongPressedCommand="{Binding DayLongPressedCommand}"
                                       DayTappedCommand="{Binding DayTappedCommand}"
                                       DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                                       DisplayDateChangedCommand="{Binding DisplayDateChangedCommand}"
                                       HeaderFormat="yyyy年 M月"
                                       Holidays="{Binding Holidays}"
                                       MonthIndicatorVisible="True"
                                       Stamps="{Binding Stamps}"
                                       WeekdayNameFormat="Abbreviated" />
                <Label Style="{StaticResource ValueLabel}"
                       HeightRequest="400"
                       Text="Parent ScrollView area. Drag vertically to scroll the page and swipe horizontally on the calendar to change the month." />
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1"
               Style="{StaticResource StatusLabel}"
               Text="{Binding Status}" />
    </Grid>

</ContentView>
