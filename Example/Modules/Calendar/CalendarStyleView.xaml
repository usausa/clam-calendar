<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamCalendar;assembly=ClamCalendar"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Calendar"
             x:Class="Example.Modules.Calendar.CalendarStyleView"
             x:DataType="{x:Type module:CalendarStyleViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CalendarStyleViewModel}"
             shell:ShellProperty.Title="Style"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Theme"
             shell:ShellProperty.Function3Text="Names"
             shell:ShellProperty.Function4Text="Header"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*,Auto">

        <!-- Application side header used when the built-in header is hidden -->
        <Grid Grid.Row="0"
              Style="{StaticResource SubMenuGrid}"
              ColumnDefinitions="Auto,*,Auto"
              IsVisible="{Binding AppHeaderVisible}">
            <Button Grid.Column="0"
                    Style="{StaticResource SubMenuButton}"
                    WidthRequest="64"
                    Command="{Binding PrevCommand}"
                    Text="&lt;" />
            <Label Grid.Column="1"
                   Style="{StaticResource TitleLabel}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Text="{Binding DisplayDate, StringFormat='{0:yyyy / MM}'}" />
            <Button Grid.Column="2"
                    Style="{StaticResource SubMenuButton}"
                    WidthRequest="64"
                    Command="{Binding NextCommand}"
                    Text="&gt;" />
        </Grid>

        <clam:ClamCalendarView Grid.Row="1"
                               CalendarStyle="{Binding CalendarStyle}"
                               DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                               DisplayDateChangedCommand="{Binding DisplayDateChangedCommand}"
                               Events="{Binding Events}"
                               HeaderVisible="{Binding HeaderVisible}"
                               Holidays="{Binding Holidays}"
                               SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                               SelectionMode="SingleDate"
                               WeekdayNameFormat="{Binding WeekdayNameFormat}" />

        <Label Grid.Row="2"
               Style="{StaticResource StatusLabel}"
               Text="{Binding Status}" />
    </Grid>

</ContentView>
