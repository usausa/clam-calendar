<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Calendar"
             xmlns:clam="clr-namespace:ClamCalendar;assembly=ClamCalendar" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls" xmlns:model="clr-namespace:Example.Models"
             x:Class="Example.Modules.Calendar.CalendarOverlayView"
             x:DataType="{x:Type module:CalendarOverlayViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CalendarOverlayViewModel}"
             shell:ShellProperty.Title="Overlay"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function4Text="Today"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid>
        <Grid Style="{StaticResource FillGrid}"
              RowDefinitions="*">
            <!-- ClamCalendarOverlay places the templated views over the days and follows the swipe on its own -->
            <Grid Grid.Row="0">
                <clam:ClamCalendarView x:Name="Calendar"
                                       DayAppearances="{Binding DayAppearances}"
                                       DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                                       DisplayDateChangedCommand="{Binding DisplayDateChangedCommand}"
                                       Events="{Binding Events}"
                                       Holidays="{Binding Holidays}"
                                       MaxVisibleSlots="2"
                                       NavigationAnimationEnabled="{Binding AnimationEnabled}" />
                <clam:ClamCalendarOverlay ItemsSource="{Binding Badges}"
                                          IsVisible="{Binding OverlayVisible}"
                                          Calendar="{x:Reference Calendar}">
                    <clam:ClamCalendarOverlay.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type model:CalendarOverlayBadge}">
                            <Border Style="{StaticResource OverlayBadge}">
                                <Label Style="{StaticResource OverlayBadgeText}"
                                       Text="{Binding Text}" />
                            </Border>
                        </DataTemplate>
                    </clam:ClamCalendarOverlay.ItemTemplate>
                </clam:ClamCalendarOverlay>
                <clam:ClamCalendarOverlay ItemsSource="{Binding TodayMarks}"
                                          IsVisible="{Binding OverlayVisible}"
                                          Calendar="{x:Reference Calendar}"
                                          Placement="DateNumber">
                    <clam:ClamCalendarOverlay.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type model:CalendarOverlayBadge}">
                            <Border Style="{StaticResource OverlayBar}" />
                        </DataTemplate>
                    </clam:ClamCalendarOverlay.ItemTemplate>
                </clam:ClamCalendarOverlay>
            </Grid>

        </Grid>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:CalendarOverlayViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="Overlay" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*">
                            <Grid Grid.Column="0"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SheetSwitchLabel}"
                                       Text="Overlay" />
                                <Switch Grid.Column="1"
                                        Style="{StaticResource SheetSwitch}"
                                        IsToggled="{Binding OverlayVisible}" />
                            </Grid>
                            <Grid Grid.Column="1"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SheetSwitchLabel}"
                                       Text="Animation" />
                                <Switch Grid.Column="1"
                                        Style="{StaticResource SheetSwitch}"
                                        IsToggled="{Binding AnimationEnabled}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
